# cmake -DIN=<lua>/src/lstrlib.c -DOUT=<build>/lstrlib_yagp.c -P patch_lstrlib.cmake
#
# Adds a work limit to Lua's pattern matcher (string.find/match/gmatch/gsub).
# The instruction-count hook in script.c never fires while a match runs in C,
# so a backtracking pattern such as ("a"):rep(1e5):find(".-.-.-b") would
# freeze the UI thread. Every matcher step (match(), singlematch(), each %b
# character, each 32 bytes of a %1 back-reference) is charged to the current
# string call; past YAGP_MATCH_STEPS the call raises a normal Lua error.
#
# Each anchor must occur exactly once, so a Lua upgrade that moves the code
# fails the build here instead of silently dropping the limit.

if(NOT IN OR NOT OUT)
    message(FATAL_ERROR "usage: cmake -DIN=lstrlib.c -DOUT=out.c -P patch_lstrlib.cmake")
endif()
file(READ "${IN}" src)

function(patch anchor replacement)
    string(FIND "${src}" "${anchor}" first)
    string(FIND "${src}" "${anchor}" last REVERSE)
    if(first EQUAL -1 OR NOT first EQUAL last)
        message(FATAL_ERROR "patch_lstrlib: anchor not found exactly once in ${IN}:\n${anchor}")
    endif()
    string(REPLACE "${anchor}" "${replacement}" patched "${src}")
    set(src "${patched}" PARENT_SCOPE)
endfunction()

# 1. Step counter in the match state.
patch("  int matchdepth;  /* control for recursive depth (to avoid C stack overflow) */\n"
      "  int matchdepth;  /* control for recursive depth (to avoid C stack overflow) */\n  size_t yagp_steps;  /* YAGP: matcher work so far in this string call */\n")

# 2. The limit and the charging macro, right after MatchState is complete.
patch("static const char *match (MatchState *ms, const char *s, const char *p);\n"
      "static const char *match (MatchState *ms, const char *s, const char *p);\n\n/* YAGP: about 0.1-0.3 s of matching on a typical PC. */\n#if !defined(YAGP_MATCH_STEPS)\n#define YAGP_MATCH_STEPS 20000000u\n#endif\n#define yagp_charge(ms, n) \\\n  (((ms)->yagp_steps += (size_t)(n)) > YAGP_MATCH_STEPS ? \\\n   (void)luaL_error((ms)->L, \"pattern too complex (step limit)\") : (void)0)\n")

# 3. Charge every match() call ...
patch("  if (l_unlikely(ms->matchdepth-- == 0))\n    luaL_error(ms->L, \"pattern too complex\");\n"
      "  if (l_unlikely(ms->matchdepth-- == 0))\n    luaL_error(ms->L, \"pattern too complex\");\n  yagp_charge(ms, 1);\n")

# 4. ... every single-character test (long [...] classes cost more) ...
patch("                        const char *ep) {\n  if (s >= ms->src_end)\n    return 0;\n"
      "                        const char *ep) {\n  yagp_charge(ms, 1 + (ep - p) / 32);\n  if (s >= ms->src_end)\n    return 0;\n")

# 5. ... every character scanned by %b ...
patch("    while (++s < ms->src_end) {\n      if (*s == e) {\n"
      "    while (++s < ms->src_end) {\n      yagp_charge(ms, 1);\n      if (*s == e) {\n")

# 6. ... and back-reference comparisons by length.
patch("  len = ms->capture[l].len;\n"
      "  len = ms->capture[l].len;\n  yagp_charge(ms, 1 + len / 32);\n")

# 7. A fresh budget per string.find/match/gmatch/gsub call (not per gmatch or
#    gsub iteration: reprepstate is left alone).
patch("  ms->matchdepth = MAXCCALLS;\n  ms->src_init = s;\n"
      "  ms->matchdepth = MAXCCALLS;\n  ms->yagp_steps = 0;\n  ms->src_init = s;\n")

file(WRITE "${OUT}.tmp" "/* Generated by cmake/patch_lstrlib.cmake from ${IN}. Do not edit. */\n${src}")
file(RENAME "${OUT}.tmp" "${OUT}")
